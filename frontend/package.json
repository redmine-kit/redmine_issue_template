{
  "name": "redmine-kit-issue-template-frontend",
  "private": true,
  "type": "module",
  "description": "The source of Redmine Kit Issue Template's module for Redmine Kit's new UI (../assets/javascripts/kit/issue_template.js)",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check:ui": "kit-check-ui",
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "check": "npm run typecheck && npm test && npm run build && npm run check:ui && npm run build-storybook"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "devDependencies": {
    "@redmine-kit/plugin": "file:../../ui/packages/plugin",
    "@redmine-kit/ui": "file:../../ui/packages/ui",
    "@tanstack/react-query": "5.108.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
