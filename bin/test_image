# shellcheck shell=bash
# Sourced by bin/test, bin/test-gem and bin/screenshots after
# bin/container_cli: the image the tests run in ($image), what they mount
# ($mounts), and the network and options of a test container ($network,
# $opts). No image is built for the plugin: $image is the base image of every
# Redmine Kit plugin's tests (test/Dockerfile: Ruby, Redmine 7.0.3 and its
# gems), tagged with the file's hash and built only when no image has that
# tag. The plugin comes as files, mounted at /src/plugins: this checkout's
# run-time and test files (tracked and new, not ignored, as they are in the
# working tree; not the module's source, whose build is in assets/). The
# image's entrypoint copies them into Redmine's plugins/ and installs the gems
# the plugin's Gemfile adds into its named volume ($name-gems), kept between
# runs. This plugin's tests need no other plugin.
: "${name:?}" "${plugin:?}" "${cli:?}"
test_context=$(mktemp -d)
mkdir -p "$test_context/plugins/$plugin"
git ls-files -co --exclude-standard . |
  grep -E '^(init\.rb|Gemfile|[^/]*\.gemspec|LICENSE|(app|assets|boot|config|db|lib|test)/)' |
  while IFS= read -r file; do if [[ -e "$file" ]]; then printf '%s\n' "$file"; fi; done | tar -cf - -T - |
  tar -xf - -C "$test_context/plugins/$plugin"
# With REDMINE_KIT_MCP=1 (bin/test's MCP run): redmine_kit_mcp and the
# redmine_kit_ui it requires, for the tests of the plugin's MCP tools
# (test/integration/mcp_tools_test.rb, skipped without them):
# REDMINE_KIT_MCP_DIR=<dir> and REDMINE_KIT_UI=<dir>, default the checkouts next
# to this one; REDMINE_KIT_MCP_REF and REDMINE_KIT_UI_REF=<commit>, default HEAD.
if [[ "${REDMINE_KIT_MCP:-}" == 1 ]]; then
  for sibling in ui mcp; do
    if [[ "$sibling" == ui ]]; then
      dir=${REDMINE_KIT_UI:-../redmine_kit_ui} ref=${REDMINE_KIT_UI_REF:-HEAD} paths=(assets)
    else
      dir=${REDMINE_KIT_MCP_DIR:-../redmine_kit_mcp} ref=${REDMINE_KIT_MCP_REF:-HEAD} paths=()
    fi
    [[ -f "$dir/init.rb" ]] || { echo "redmine_kit_$sibling is not in $dir" >&2; exit 1; }
    mkdir -p "$test_context/plugins/redmine_kit_$sibling"
    git -C "$dir" archive "$ref" init.rb Gemfile boot app config db lib ${paths[@]+"${paths[@]}"} |
      tar -xf - -C "$test_context/plugins/redmine_kit_$sibling"
  done
fi
# Redmine from its repository instead of the 7.0.3 release: REDMINE_BRANCH=
# <branch> (master) at the branch's current commit, or REDMINE_COMMIT=<sha>;
# a base image of its own, tagged with the commit.
build_args=()
redmine_commit=${REDMINE_COMMIT:-}
if [[ -z "$redmine_commit" && -n "${REDMINE_BRANCH:-}" ]]; then
  redmine_commit=$(git ls-remote https://github.com/redmine/redmine.git "refs/heads/$REDMINE_BRANCH" | cut -f1)
  [[ -n "$redmine_commit" ]] || { echo "no branch $REDMINE_BRANCH in Redmine's repository" >&2; exit 1; }
fi
image=redmine-kit-test-base:$(shasum -a 256 test/Dockerfile | cut -c1-12)
if [[ -n "$redmine_commit" ]]; then
  build_args=(--build-arg REDMINE_COMMIT="$redmine_commit")
  image=$image-${redmine_commit:0:12}
fi
# One build of an image at a time on this machine, as the other plugins' bin/test_slot does (the same lock).
test_build_lock="${TMPDIR:-/tmp}/redmine-kit-ui-test-slots/build"
mkdir -p "${test_build_lock%/*}"
if ! "$cli" image inspect "$image" >/dev/null 2>&1; then
  until mkdir "$test_build_lock" 2>/dev/null; do
    holder=$(cat "$test_build_lock/pid" 2>/dev/null || true)
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then rm -rf "$test_build_lock"; else sleep 2; fi
  done
  echo $$ >"$test_build_lock/pid"
  # another run may have built it while this one waited
  if ! "$cli" image inspect "$image" >/dev/null 2>&1; then
    empty=$(mktemp -d)
    if [[ "$cli" == docker ]]; then
      docker buildx build --load -q -t "$image" ${build_args[@]+"${build_args[@]}"} -f test/Dockerfile "$empty" >/dev/null ||
        { rm -rf "$test_build_lock"; exit 1; }
    else
      # The build's log only when it fails (`container build -q` doesn't return).
      log=$(mktemp)
      container build --progress plain -t "$image" ${build_args[@]+"${build_args[@]}"} -f test/Dockerfile "$empty" \
        >"$log" 2>&1 || { cat "$log" >&2; rm -rf "$test_build_lock"; exit 1; }
      rm -f "$log"
    fi
    rmdir "$empty"
  fi
  rm -rf "$test_build_lock"
fi
# The plugin's gems volume holds one run at a time (Apple container attaches a
# named volume to one container only): runs of this plugin wait for each other.
gems_lock="${TMPDIR:-/tmp}/$name-gems.lock"
# A script that sources this file again while its caller holds the lock (as
# bin/update-schema does under redmine_kit_aws_dsql's bin/test) uses the
# caller's lock: GEMS_LOCK_OWNER names the process that took it, and only that
# process releases it. Waiting for its own caller would never end.
gems_lock_owned=""
if [[ -z "${GEMS_LOCK_OWNER:-}" || "$(cat "$gems_lock/pid" 2>/dev/null)" != "$GEMS_LOCK_OWNER" ]]; then
  # Another run of these tests: wait for it, at most GEMS_LOCK_TIMEOUT seconds
  # (default 3600), then stop with a message.
  gems_lock_waited=0
  until [[ "$(cat "$gems_lock/pid" 2>/dev/null)" == "$$" ]] || mkdir "$gems_lock" 2>/dev/null; do
    holder=$(cat "$gems_lock/pid" 2>/dev/null || true)
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
      rm -rf "$gems_lock"
    elif ((gems_lock_waited >= ${GEMS_LOCK_TIMEOUT:-3600})); then
      echo "The gems volume of these tests is still in use by process ${holder:-?} (another run) after" \
        "${gems_lock_waited}s. Wait for it or stop it, then run again (GEMS_LOCK_TIMEOUT sets the wait)." >&2
      exit 1
    else
      sleep 3
      gems_lock_waited=$((gems_lock_waited + 3))
    fi
  done
  echo $$ >"$gems_lock/pid"
  export GEMS_LOCK_OWNER=$$
  gems_lock_owned=1
fi
# After the script's own clean-up, if it has one (bin/test_slot's, the services'):
# `trap -p` quotes it, so that it is read back as it was.
eval "previous_exit_trap=($(trap -p EXIT))"
# shellcheck disable=SC2064,SC2154 # the variables at exit; the earlier clean-up as it is now
trap "rm -rf \"\$test_context\"${gems_lock_owned:+ \"\$gems_lock\"}${previous_exit_trap[2]:+; ${previous_exit_trap[2]}}" EXIT
mounts=(-v "$test_context/plugins:/src/plugins" -v "$name-gems:/extra-gems")
# The network of the PostgreSQL container (bin/services) and the options of a
# test container on it ($network, $opts; bin/test, bin/test-gem). In Docker by
# its name; in Apple container by its address, since containers don't find each
# other by name there, and with more memory than the 1 GB a container gets by
# default, for the parallel workers.
# shellcheck disable=SC2034 # the scripts that source this file read them
if [[ "$cli" == docker ]]; then
  network=redmine-kit-issue-template-test_default
  opts=("${mounts[@]}")
else
  network=$kit_test_network
  opts=(-m 4G "${mounts[@]}" -e TEST_DATABASE_HOST="$(container inspect redmine-kit-issue-template-test-postgres |
    sed -n 's/.*"ipv4Address" : "\([0-9.]*\)\/.*/\1/p' | head -1)")
fi
