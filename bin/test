#!/usr/bin/env bash
# The plugin's tests in Redmine 7.0.3 on PostgreSQL 16, in Docker.
#   bin/test              # the plugin's tests, then Redmine's tests of the issue form
#   bin/test --redmine    # also every Redmine test, with the plugin installed
#   bin/test <files>      # some files of the plugin's tests
#   REDMINE_BRANCH=master bin/test   # on Redmine's master branch
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
image=redmine-issue-template-test${REDMINE_BRANCH:+-$REDMINE_BRANCH}
network=redmine-issue-template-test_default
bin/services >/dev/null
docker buildx build --load -q -t "$image" --build-arg REDMINE_BRANCH="${REDMINE_BRANCH:-}" -f test/Dockerfile . >/dev/null
setup='bin/rails db:drop db:create db:migrate redmine:plugins:migrate db:schema:dump >/dev/null'
run() {
  docker run --rm --network "$network" -e PARALLEL_WORKERS="${PARALLEL_WORKERS:-4}" "$image" \
    sh -c "$setup"' && "$@"' test "$@"
}
# The plugin's tests, with coverage written to coverage/coverage.xml.
run_plugin() {
  mkdir -p coverage
  docker run --rm --network "$network" -e PLUGIN_COVERAGE=1 -e PARALLEL_WORKERS=1 \
    -v "$PWD/coverage:/redmine/plugins/redmine_issue_template/coverage" "$image" \
    sh -c "$setup"' && "$@"' test "$@"
}
redmine_tests=(test/functional/issues_controller_test.rb test/functional/projects_controller_test.rb
  test/unit/issue_test.rb test/unit/repository_git_test.rb)
# Redmine's tests that fail with the current gems for known reasons.
known=$(grep -v -e '^#' -e '^$' test/redmine_known_failures.txt | sed 's/[.]/\\./g' | paste -sd '|' -)
if [[ "${1:-}" == "--redmine" ]]; then
  run_plugin bin/rails test plugins/redmine_issue_template/test
  run bin/rails test --exclude "/^($known)\$/"
elif (($#)); then
  run_plugin bin/rails test "${@/#/plugins/redmine_issue_template/}"
else
  run_plugin bin/rails test plugins/redmine_issue_template/test
  run bin/rails test --exclude "/^($known)\$/" "${redmine_tests[@]}"
fi
