#!/usr/bin/env bash
# The plugin's tests in Redmine 7.0.3 on PostgreSQL 16, in Apple container when
# it runs, else in Docker (CONTAINER_CLI=container|docker chooses).
#   bin/test              # the plugin's tests, then Redmine's tests of the issue form
#   bin/test --redmine    # also every Redmine test, with the plugin installed
#   bin/test <files>      # some files of the plugin's tests
#   REDMINE_KIT_MCP=1 bin/test test/integration/mcp_tools_test.rb   # with redmine_kit_mcp
#   REDMINE_BRANCH=master bin/test   # on Redmine's master branch
#   COVERAGE=1 bin/test   # also the plugin's coverage, in coverage/coverage.xml
# bin/test-gem checks the plugin installed as a gem.
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
source bin/container_cli
name=redmine-kit-issue-template-test
plugin=redmine_kit_issue_template
bin/services >/dev/null
source bin/test_image
setup='bin/rails db:drop db:create db:migrate redmine:plugins:migrate db:schema:dump >/dev/null'
# A database of this run's own (test/database.yml reads TEST_DATABASE): runs at
# the same time share the PostgreSQL container. Dropped when the tests end.
db="redmine_test_$$"
teardown='; status=$?; bin/rails db:drop >/dev/null 2>&1; exit $status'
run() {
  "$cli" run --rm --network "$network" ${opts[@]+"${opts[@]}"} -e TEST_DATABASE="$db" \
    -e PARALLEL_WORKERS="${PARALLEL_WORKERS:-4}" "$image" sh -c "$setup"' && "$@"'"$teardown" test "$@"
}
# The plugin's tests. With COVERAGE=1 (CI sets it), also their coverage of the
# plugin's files (test/test_helper.rb), written to coverage/coverage.xml by one
# worker, whose result is the whole run's. COVERAGE itself stays out of the
# container: Redmine's test_helper starts its own SimpleCov with it.
run_plugin() {
  if [[ -z "${COVERAGE:-}" ]]; then
    run "$@"
    return
  fi
  mkdir -p coverage
  rm -f coverage/.resultset.json
  "$cli" run --rm --network "$network" ${opts[@]+"${opts[@]}"} -e TEST_DATABASE="$db" -e PLUGIN_COVERAGE=plugin \
    -e PARALLEL_WORKERS=1 -v "$PWD/coverage:/redmine/plugins/redmine_kit_issue_template/coverage" "$image" \
    sh -c "$setup"' && "$@"'"$teardown" test "$@"
}
redmine_tests=(test/functional/issues_controller_test.rb test/functional/projects_controller_test.rb
  test/unit/issue_test.rb test/unit/repository_git_test.rb)
# Redmine's tests that fail with the current gems for known reasons.
known=$(grep -v -e '^#' -e '^$' test/redmine_known_failures.txt | sed 's/[.]/\\./g' | paste -sd '|' -)
if [[ "${1:-}" == "--redmine" ]]; then
  run_plugin bin/rails test plugins/redmine_kit_issue_template/test
  run bin/rails test --exclude "/^($known)\$/"
elif (($#)); then
  run_plugin bin/rails test "${@/#/plugins/redmine_kit_issue_template/}"
else
  run_plugin bin/rails test plugins/redmine_kit_issue_template/test
  run bin/rails test --exclude "/^($known)\$/" "${redmine_tests[@]}"
  # the MCP tools, with redmine_kit_mcp and redmine_kit_ui (bin/test_image)
  REDMINE_KIT_MCP=1 bin/test test/integration/mcp_tools_test.rb
fi
