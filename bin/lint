#!/usr/bin/env bash
# Static checks: the newest RuboCop and Brakeman (security) published at least
# 3 days ago, in Apple container when it runs, else in Docker
# (CONTAINER_CLI=container|docker chooses). Arguments go to RuboCop.
# No lock is committed; bundle update resolves the gems again on every run.
set -euo pipefail
cd "$(dirname "$0")/.."
RUBY=ruby:4.0@sha256:4de17567bc750e8a509fd2181e5c5eda3137bbb635b046943277c90271e4ec1c
source bin/container_cli
"$cli" run --rm -v "$PWD:/work" -w /work -v redmine-kit-issue-template-bundle:/usr/local/bundle \
  -e BUNDLE_GEMFILE=Gemfile.lint "$RUBY" \
  sh -c 'bundle update --quiet --cooldown=3 && bundle exec rubocop "$@" &&
    bundle exec brakeman --force --quiet --no-pager --exit-on-warn --exit-on-error .' rubocop "$@"
