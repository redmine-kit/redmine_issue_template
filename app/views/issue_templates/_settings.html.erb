<%# Project settings › Issue templates, after the other settings tabs
    (projects/settings/_issue_categories). %>
<% source = IssueTemplateSource.find_by(project_id: @project.id) %>
<% manual = source.nil? || source.manual? %>
<% set = RedmineIssueTemplate::TemplateSet.for(@project) %>
<% messages = IssueTemplateSource.messages_for(@project, source) %>
<% files = IssueTemplateFile.where(project_id: @project.id).sort_by { |file| RedmineIssueTemplate::Parser.sort_key(file.path) } %>

<p>
  <%= link_to sprite_icon('add', l(:label_issue_template_file_new)), new_project_issue_template_path(@project), class: 'icon icon-add' if manual %>
  <%= link_to sprite_icon('import', l(:button_import)), project_sync_issue_templates_path(@project),
              method: :post, class: 'icon icon-import' if @project.repository %>
  <%= link_to sprite_icon('help', l(:label_help)), "#{RedmineIssueTemplate::DOCS_URL}#{'ja/' if current_language.to_s == 'ja'}format",
              class: 'icon icon-help' %>
</p>

<%= render partial: 'issue_templates/source', locals: { source: source } unless manual %>

<%# The problems themselves are on each file's page. %>
<% if messages.any?(&:error?) %>
<div id="errorExplanation"><%= notice_icon('error') %><%= l(:text_issue_template_files_with_errors) %></div>
<% end %>

<% if Setting.text_formatting != 'common_mark' %>
<% common_mark = Redmine::WikiFormatting.formats_for_select.to_h.invert['common_mark'] %>
<p class="warning"><%= l(:warning_issue_template_text_formatting, name: common_mark) %></p>
<% end %>

<% if files.any? %>
<table class="list issue-template-files">
  <thead><tr>
    <th><%= l(:field_filename) %></th>
    <th><%= l(:field_name) %></th>
    <th><%= l(:field_tracker) %></th>
    <th></th>
    <th></th>
  </tr></thead>
  <tbody>
  <% files.each do |file| %>
    <% template = set.templates.detect { |t| t.path == file.path } %>
    <% errors = messages.select { |m| m.path == file.path && m.error? } %>
    <tr>
      <td class="name"><%= link_to file.path, project_issue_template_path(@project, file) %></td>
      <td class="description"><%= template&.name %></td>
      <td><%= template&.tracker(@project)&.name %></td>
      <td class="tick">
        <%# As on Redmine's Information page %>
        <span class="icon-only icon-<%= errors.empty? ? 'ok' : 'error' %>">
          <%= errors.empty? ? sprite_icon('checked') : sprite_icon('warning') %>
        </span>
      </td>
      <td class="buttons">
        <% if manual %>
          <%= link_to sprite_icon('edit', l(:button_edit)), edit_project_issue_template_path(@project, file), class: 'icon icon-edit' %>
          <%= delete_link project_issue_template_path(@project, file) %>
        <% end %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
<% else %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% end %>

<%# The chooser's settings, kept in config.yml. Saved from here when the
    templates are edited in Redmine; shown only when they come from elsewhere. %>
<% config = set.config %>
<% content_for :header_tags do %><%= stylesheet_link_tag 'issue_template', plugin: 'redmine_issue_template' %><% end %>
<%= form_tag project_issue_template_settings_path(@project), method: :patch do %>
<fieldset class="box issue-template-chooser-settings">
  <legend><%= l(:label_issue_template_chooser) %></legend>
  <p>
    <%= hidden_field_tag 'blank_issues_enabled', '0', id: nil if manual %>
    <label class="inline">
      <%= check_box_tag 'blank_issues_enabled', '1', config.blank_issues_enabled?, disabled: !manual %>
      <%= l(:label_issue_template_blank_issues_enabled) %>
    </label>
  </p>
  <p><%= l(:label_issue_template_contact_links) %></p>
  <table class="list issue-template-contact-links">
    <thead><tr>
      <th><%= l(:field_name) %></th>
      <th><%= l(:field_url) %></th>
      <th><%= l(:field_description) %></th>
    </tr></thead>
    <tbody>
    <%# One empty row to add a link; emptying a row removes its link. %>
    <% (config.contact_links + (manual ? [nil] : [])).each do |link| %>
      <tr>
      <% %i[name url about].each do |key| %>
        <td><%= text_field_tag "contact_links[][#{key}]", link&.public_send(key), id: nil, size: key == :about ? 50 : 25,
                               disabled: !manual, 'aria-label': l(key == :about ? :field_description : :"field_#{key}") %></td>
      <% end %>
      </tr>
    <% end %>
    </tbody>
  </table>
  <% unless manual %><em class="info"><%= l(:text_issue_template_chooser_elsewhere) %></em><% end %>
</fieldset>
<%= submit_tag l(:button_save) if manual %>
<% end %>
