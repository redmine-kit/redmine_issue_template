<%# Under the page's title: what the template is for and, for a form, the
    box of its subject and fields, which starts with that text and the
    form's first markdown elements. %>
<% if issue.issue_template_active? %>
<% template = issue.issue_template %>
<% content_for :header_tags do %><%= stylesheet_link_tag 'issue_template', plugin: 'redmine_issue_template' %><% end %>
<% if template.form? %>
<%= render partial: 'issue_templates/form_fields', locals: { issue: issue } %>
<% elsif template.about.present? %>
<div class="wiki issue-template-intro"><p><%= template.about %></p></div>
<% end %>
<% end %>
