<%= title [l(:label_issue_template_plural), settings_project_path(@project, tab: 'issue_templates')], @file.path_was.presence || @file.path %>

<%= labelled_form_for @file, as: :issue_template_file, url: project_issue_template_path(@project, @file), method: :patch do |f| %>
<%= render partial: 'issue_templates/file_form', locals: { f: f } %>
<%= submit_tag l(:button_save) %>
<%= submit_tag l(:label_preview), name: 'preview' %>
<%= link_to l(:button_cancel), settings_project_path(@project, tab: 'issue_templates') %>
<% end %>

<%= render partial: 'issue_templates/preview' %>
