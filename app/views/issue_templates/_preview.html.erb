<%# What users see with the file: the chooser and Redmine's New issue form,
    shown but not usable (inert). In a box with a legend, as the issue
    edit page groups its fields (issues/_edit). %>
<% if @preview_errors.present? %>
<div id="errorExplanation">
  <ul>
  <% @preview_errors.each do |message| %>
    <li><%= message.text %></li>
  <% end %>
  </ul>
</div>
<% elsif @preview %>
<div class="box">
<fieldset class="tabular issue-template-preview" inert>
  <legend><%= l(:label_preview) %></legend>
  <%= render partial: 'issue_templates/chooser', locals: @preview %>
  <% if @issue %>
  <br />
  <h3><%= l(:label_issue_new) %></h3>
  <div id="all_attributes"><%= render partial: 'issues/form' %></div>
  <% end %>
</fieldset>
</div>
<% end %>
