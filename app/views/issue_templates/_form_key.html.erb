<%# The chosen template, kept when Redmine updates the form, and the values
    the template sets, as text, as Redmine shows a status the user can't
    change. %>
<% if issue.issue_template_active? %>
<%= hidden_field_tag 'issue_template', issue.issue_template.key, id: nil %>
<% labels = { 'tracker_id' => :field_tracker, 'priority_id' => :field_priority, 'category_id' => :field_category,
              'fixed_version_id' => :field_fixed_version, 'is_private' => :field_is_private } %>
<%# A form shows its tracker in its own box (_form_fields). %>
<% fixed = issue.issue_template_visibility[:fixed] %>
<% fixed -= ['tracker_id'] if issue.issue_template.form? %>
<% labels.each do |name, label| %>
<% next unless fixed.include?(name) %>
<p><label><%= l(label) %></label> <span class="issue-template-value"><%= format_object(issue.public_send(name.delete_suffix('_id'))) %></span></p>
<% end %>
<% issue.custom_field_values.each do |value| %>
<% next unless fixed.include?(value.custom_field_id.to_s) && value.custom_field.visible_by?(issue.project) %>
<p><label><%= value.custom_field.name %></label> <span class="issue-template-value"><%= show_value(value) %></span></p>
<% end %>
<% end %>
