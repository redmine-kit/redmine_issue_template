<%# At the top of Redmine's form, rendered again with it on each update: the
    chosen template, and what the template shows (a form's part, or the
    values a Markdown template sets). %>
<% if issue.issue_template_active? %>
<% content_for :header_tags do %><%= stylesheet_link_tag 'issue_template', plugin: 'redmine_issue_template' %><% end %>
<%= hidden_field_tag 'issue_template', issue.issue_template.key, id: nil %>
<% if issue.issue_template.form? %>
<%= render partial: 'issue_templates/form_fields', locals: { issue: issue } %>
<% else %>
<%= render partial: 'issue_templates/preset_values', locals: { issue: issue } %>
<% end %>
<% end %>
