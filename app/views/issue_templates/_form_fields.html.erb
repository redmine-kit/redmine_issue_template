<%# A form's text, tracker, subject and fields, in a box above Redmine's
    form. The fields join the form by their form attribute, so they are
    submitted with it and Redmine's updates of the form leave them alone. %>
<% if issue.issue_template_active? && issue.issue_template.form? %>
<% composer = issue.issue_template_composer %>
<% form = 'issue-form' %>
<div class="box tabular issue-template-fields">
<%# In div.wiki, as the markdown elements, so that the text starts at the
    box's edge rather than at the fields. %>
<% if issue.issue_template.about.present? %><div class="wiki"><p><%= issue.issue_template.about %></p></div><% end %>
<% issue.issue_template.elements.take_while { |element| element.type == 'markdown' }.each do |element| %>
<div class="wiki"><%= issue_template_markdown(element.attributes['value']) %></div>
<% end %>
<% if issue.issue_template_visibility[:fixed].include?('tracker_id') %>
<p><label><%= l(:field_tracker) %></label> <span class="issue-template-value"><%= issue.tracker %></span></p>
<% else %>
<%# Not Redmine's id: Redmine's form, rendered again on each update, resets
    #issue_tracker_id to the tracker it was rendered with. %>
<p>
  <%= label_tag 'issue_template_tracker_id' do %><%= l(:field_tracker) %><span class="required"> *</span><% end %>
  <%= select_tag 'issue[tracker_id]', options_for_select(trackers_options_for_select(issue), issue.tracker_id),
                 id: 'issue_template_tracker_id', form: form,
                 onchange: "updateIssueFrom('#{escape_javascript update_issue_form_path(issue.project, issue)}', this)" %>
</p>
<% end %>
<p>
  <%= label_tag 'issue_subject' do %><%= l(:field_subject) %><span class="required"> *</span><% end %>
  <%= text_field_tag 'issue[subject]', issue.subject, id: 'issue_subject', size: 80, maxlength: 255, form: form %>
</p>
<% (issue.issue_template.elements.drop_while { |element| element.type == 'markdown' } - issue.issue_template_dropped).each do |element| %>
  <% name = "issue_template_answers[#{element.ref}]" %>
  <% field_id = "issue_template_answer_#{element.ref}" %>
  <% value = composer.value(element) %>
  <%# Only validations.required marks the field; required checkbox options are marked on the option. %>
  <% required = element.required? %>
  <% case element.type %>
  <% when 'markdown' %>
  <div class="wiki"><%= issue_template_markdown(element.attributes['value']) %></div>
  <% when 'input' %>
  <p>
    <%= label_tag field_id do %><%= element.label %><%= content_tag(:span, ' *', class: 'required') if required %><% end %>
    <%= text_field_tag name, value, id: field_id, size: 60, placeholder: element.attributes['placeholder'], form: form %>
    <% if element.attributes['description'].present? %><em class="info"><%= issue_template_markdown(element.attributes['description'], inline: true) %></em><% end %>
  </p>
  <% when 'textarea' %>
  <p>
    <%= label_tag field_id do %><%= element.label %><%= content_tag(:span, ' *', class: 'required') if required %><% end %>
    <%= text_area_tag name, value, id: field_id, cols: 60, rows: 6, placeholder: element.attributes['placeholder'],
                      class: (element.attributes['render'].present? ? nil : 'wiki-edit'), form: form %>
    <% if element.attributes['description'].present? %><em class="info"><%= issue_template_markdown(element.attributes['description'], inline: true) %></em><% end %>
  </p>
  <% when 'dropdown' %>
  <p>
    <%= label_tag field_id do %><%= element.label %><%= content_tag(:span, ' *', class: 'required') if required %><% end %>
    <%# A linked dropdown offers the choices of the issue's field. %>
    <% link = issue.issue_template_links.find { |linked| linked.element.equal?(element) } %>
    <% labels = link ? link.choices(issue).map(&:first) : element.options %>
    <% options = labels.each_with_index.map { |option, index| [option.to_s, index.to_s] } %>
    <% if element.multiple? %>
    <%= select_tag "#{name}[]", options_for_select(options, Array(value)), id: field_id, multiple: true, form: form %>
    <% else %>
    <%= select_tag name, options_for_select(options, value), id: field_id, include_blank: !element.attributes.key?('default'), form: form %>
    <% end %>
    <% if element.attributes['description'].present? %><em class="info"><%= issue_template_markdown(element.attributes['description'], inline: true) %></em><% end %>
  </p>
  <% when 'checkboxes' %>
  <p>
    <label><%= element.label %><%= content_tag(:span, ' *', class: 'required') if required %></label>
    <% element.checkbox_options.each_with_index do |option, index| %>
    <label class="block">
      <%= check_box_tag "#{name}[]", index.to_s, Array(value).map(&:to_s).include?(index.to_s), id: "#{field_id}_#{index}", form: form %>
      <%= issue_template_markdown(option[:label], inline: true) %><%= content_tag(:span, ' *', class: 'required') if option[:required] %>
    </label>
    <% end %>
    <%# Posts the answer when nothing is checked, so that the field doesn't go back to its default. %>
    <%= hidden_field_tag "#{name}[]", '', id: nil, form: form %>
    <% if element.attributes['description'].present? %><em class="info"><%= issue_template_markdown(element.attributes['description'], inline: true) %></em><% end %>
  </p>
  <% when 'upload' %>
  <p>
    <label><%= element.label %><%= content_tag(:span, ' *', class: 'required') if required %></label>
    <em class="info"><%= issue_template_markdown(element.attributes['description'], inline: true) if element.attributes['description'].present? %> <%= l(:text_issue_template_upload) %></em>
  </p>
  <% end %>
<% end %>
</div>
<% end %>
