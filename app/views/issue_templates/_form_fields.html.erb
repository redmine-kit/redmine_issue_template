<%# An issue form's fields, in the issue form's tabular layout. %>
<% if issue.issue_template_active? && issue.issue_template.form? %>
<% composer = issue.issue_template_composer %>
<% issue.issue_template.elements.each do |element| %>
  <% name = "issue_template_answers[#{element.ref}]" %>
  <% field_id = "issue_template_answer_#{element.ref}" %>
  <% value = composer.value(element) %>
  <% required = element.required? || (element.type == 'checkboxes' && element.checkbox_options.any? { |o| o[:required] }) %>
  <% case element.type %>
  <% when 'markdown' %>
  <div class="wiki"><%= issue_template_markdown(element.attributes['value']) %></div>
  <% when 'input' %>
  <p>
    <%= label_tag field_id do %><%= element.label %><%= content_tag(:span, ' *', class: 'required') if required %><% end %>
    <%= text_field_tag name, value, id: field_id, size: 60, placeholder: element.attributes['placeholder'] %>
    <% if element.attributes['description'].present? %><em class="info"><%= issue_template_markdown(element.attributes['description'], inline: true) %></em><% end %>
  </p>
  <% when 'textarea' %>
  <p>
    <%= label_tag field_id do %><%= element.label %><%= content_tag(:span, ' *', class: 'required') if required %><% end %>
    <%= text_area_tag name, value, id: field_id, cols: 60, rows: 6, placeholder: element.attributes['placeholder'],
                      class: (element.attributes['render'].present? ? nil : 'wiki-edit') %>
    <% if element.attributes['description'].present? %><em class="info"><%= issue_template_markdown(element.attributes['description'], inline: true) %></em><% end %>
  </p>
  <% when 'dropdown' %>
  <p>
    <%= label_tag field_id do %><%= element.label %><%= content_tag(:span, ' *', class: 'required') if required %><% end %>
    <% options = element.options.each_with_index.map { |option, index| [option.to_s, index.to_s] } %>
    <% if element.multiple? %>
    <%= select_tag "#{name}[]", options_for_select(options, Array(value)), id: field_id, multiple: true %>
    <% else %>
    <%= select_tag name, options_for_select(options, value), id: field_id, include_blank: !element.attributes.key?('default') %>
    <% end %>
    <% if element.attributes['description'].present? %><em class="info"><%= issue_template_markdown(element.attributes['description'], inline: true) %></em><% end %>
  </p>
  <% when 'checkboxes' %>
  <p>
    <label><%= element.label %><%= content_tag(:span, ' *', class: 'required') if required %></label>
    <% element.checkbox_options.each_with_index do |option, index| %>
    <label class="block">
      <%= check_box_tag "#{name}[]", index.to_s, Array(value).map(&:to_s).include?(index.to_s), id: "#{field_id}_#{index}" %>
      <%= issue_template_markdown(option[:label], inline: true) %><%= content_tag(:span, ' *', class: 'required') if option[:required] %>
    </label>
    <% end %>
    <%= hidden_field_tag "#{name}[]", '', id: nil %>
    <% if element.attributes['description'].present? %><em class="info"><%= issue_template_markdown(element.attributes['description'], inline: true) %></em><% end %>
  </p>
  <% when 'upload' %>
  <p>
    <label><%= element.label %><%= content_tag(:span, ' *', class: 'required') if required %></label>
    <em class="info"><%= issue_template_markdown(element.attributes['description'], inline: true) if element.attributes['description'].present? %> <%= l(:text_issue_template_upload) %></em>
  </p>
  <% end %>
<% end %>
<% end %>
