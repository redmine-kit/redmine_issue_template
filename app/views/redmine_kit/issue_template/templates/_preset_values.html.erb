<%# The values the template sets, as text, as Redmine shows a status the
    user can't change (PresetValues, for the new UI's form too). except:
    fields shown elsewhere. %>
<% RedmineKit::IssueTemplate::PresetValues.new(issue, except: local_assigns.fetch(:except, [])).each do |entry| %>
<p><label><%= entry.label %></label> <span class="issue-template-value"><%= format_object(entry.value) %></span></p>
<% end %>
